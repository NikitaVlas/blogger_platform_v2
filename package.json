{
  "name": "blogger_platform_v2",
  "packageManager": "yarn@4.6.0",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/index.js",
    "codebase:index": "codebase-memory-mcp cli index_repository --repo-path . --persistence false",
    "codebase:status": "codebase-memory-mcp cli list_projects",
    "watch": "tsc -w",
    "dev": "nodemon --inspect --watch dist dist/index.js",
    "jest": "jest -i",
    "lint": "eslint --fix .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "inversify": "^8.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.3.0",
    "mongoose": "^0.0.2-security",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "codebase-memory-mcp": "^0.9.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
